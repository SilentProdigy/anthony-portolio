# Server-only settings for Vercel Preview deployment.
# Never prefix these with VITE_ or commit real credentials.

# Required: leads are saved whether or not email is enabled.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LEAD_HASH_SALT=

# Email mode:
# off     = save leads in Supabase only (no sending domain needed)
# testing = send an owner-only Resend notification from onboarding@resend.dev
# verified= send owner notification AND visitor acknowledgment with your verified domain
RESEND_MODE=off

# Required only for testing or verified mode.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# Required only for verified mode.
RESEND_FROM_EMAIL=
